# Copie este arquivo para .env antes de iniciar o OPERIX.
# Use senhas novas e nao envie o arquivo .env para repositorios ou terceiros.

POSTGRES_DB=operix
POSTGRES_USER=operix
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE_DO_BANCO
JWT_SECRET=TROQUE_POR_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_64_CARACTERES

# Porta publicada pelo Nginx na rede local.
WEB_PORT=8080

# Troque pelo IP ou nome DNS do servidor Debian na rede local.
APP_ORIGIN=http://192.168.0.10:8080
