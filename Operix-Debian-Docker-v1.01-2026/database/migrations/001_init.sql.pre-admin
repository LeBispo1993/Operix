CREATE EXTENSION IF NOT EXISTS pgcrypto;
CREATE TYPE user_role AS ENUM ('REQUESTER','USER','TECHNICIAN','MANAGER','DIRECTOR','ADMIN','SUPER_ADMIN');
CREATE TYPE ticket_status AS ENUM ('NEW','TRIAGE','PLANNED','IN_PROGRESS','WAITING','RESOLVED','CLOSED','CANCELLED');
CREATE TYPE maintenance_kind AS ENUM ('PREVENTIVE','CORRECTIVE','PREDICTIVE');
CREATE TYPE priority_level AS ENUM ('LOW','NORMAL','HIGH','CRITICAL');

CREATE TABLE tenants (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), code text UNIQUE NOT NULL, name text NOT NULL, active boolean NOT NULL DEFAULT true, created_at timestamptz NOT NULL DEFAULT now());
CREATE TABLE sectors (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), name text NOT NULL, cost_center text, active boolean NOT NULL DEFAULT true, UNIQUE(tenant_id,name));
CREATE TABLE people (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), sector_id uuid REFERENCES sectors(id), full_name text NOT NULL, document text NOT NULL, email text, phone text, photo_key text, signature_key text, active boolean NOT NULL DEFAULT true, created_at timestamptz NOT NULL DEFAULT now(), UNIQUE(tenant_id,document));
CREATE TABLE users (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), person_id uuid NOT NULL UNIQUE REFERENCES people(id), email text UNIQUE NOT NULL, password_hash text NOT NULL, must_change_password boolean NOT NULL DEFAULT true, active boolean NOT NULL DEFAULT true, failed_attempts int NOT NULL DEFAULT 0, locked_until timestamptz, created_at timestamptz NOT NULL DEFAULT now());
CREATE TABLE memberships (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), user_id uuid NOT NULL REFERENCES users(id), tenant_id uuid NOT NULL REFERENCES tenants(id), sector_id uuid REFERENCES sectors(id), role user_role NOT NULL, active boolean NOT NULL DEFAULT true, UNIQUE(user_id,tenant_id,sector_id,role));
CREATE TABLE priorities (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), level priority_level NOT NULL, name text NOT NULL, response_minutes int NOT NULL, resolution_minutes int NOT NULL, UNIQUE(tenant_id,level));
CREATE TABLE assets (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), sector_id uuid REFERENCES sectors(id), tag text NOT NULL, name text NOT NULL, category text NOT NULL, serial_number text, status text NOT NULL DEFAULT 'ACTIVE', purchase_date date, warranty_until date, metadata jsonb NOT NULL DEFAULT '{}', UNIQUE(tenant_id,tag));
CREATE TABLE tickets (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), sector_id uuid REFERENCES sectors(id), requester_id uuid NOT NULL REFERENCES people(id), assignee_id uuid REFERENCES people(id), asset_id uuid REFERENCES assets(id), priority_id uuid REFERENCES priorities(id), number bigint GENERATED ALWAYS AS IDENTITY, category text NOT NULL, title text NOT NULL, description text NOT NULL, status ticket_status NOT NULL DEFAULT 'NEW', requested_at timestamptz NOT NULL DEFAULT now(), started_at timestamptz, finished_at timestamptz, due_at timestamptz, UNIQUE(tenant_id,number));
CREATE TABLE work_orders (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), ticket_id uuid REFERENCES tickets(id), asset_id uuid REFERENCES assets(id), kind maintenance_kind NOT NULL, number bigint GENERATED ALWAYS AS IDENTITY, status text NOT NULL DEFAULT 'OPEN', scheduled_for timestamptz, started_at timestamptz, finished_at timestamptz, result text, labor_minutes int, accepted_by uuid REFERENCES people(id), accepted_at timestamptz, UNIQUE(tenant_id,number));
CREATE TABLE maintenance_plans (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), asset_id uuid NOT NULL REFERENCES assets(id), kind maintenance_kind NOT NULL, frequency_days int, meter_interval numeric, next_due_at timestamptz, active boolean NOT NULL DEFAULT true);
CREATE TABLE warehouses (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), sector_id uuid REFERENCES sectors(id), name text NOT NULL, UNIQUE(tenant_id,name));
CREATE TABLE items (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), sku text NOT NULL, name text NOT NULL, unit text NOT NULL, category text NOT NULL, ca_number text, image_key text, min_stock numeric NOT NULL DEFAULT 0, active boolean NOT NULL DEFAULT true, UNIQUE(tenant_id,sku));
CREATE TABLE stock_movements (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), warehouse_id uuid NOT NULL REFERENCES warehouses(id), item_id uuid NOT NULL REFERENCES items(id), work_order_id uuid REFERENCES work_orders(id), movement_type text NOT NULL, quantity numeric NOT NULL CHECK(quantity > 0), unit_cost numeric(14,2), occurred_at timestamptz NOT NULL DEFAULT now());
CREATE TABLE purchase_requests (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), requester_id uuid NOT NULL REFERENCES people(id), sector_id uuid REFERENCES sectors(id), number bigint GENERATED ALWAYS AS IDENTITY, status text NOT NULL DEFAULT 'DRAFT', justification text NOT NULL, estimated_total numeric(14,2), created_at timestamptz NOT NULL DEFAULT now(), UNIQUE(tenant_id,number));
CREATE TABLE epi_requests (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), requester_id uuid NOT NULL REFERENCES people(id), number bigint GENERATED ALWAYS AS IDENTITY, request_type text NOT NULL, reason text NOT NULL, status text NOT NULL DEFAULT 'PENDING', requested_at timestamptz NOT NULL DEFAULT now(), separated_by uuid REFERENCES people(id), delivered_at timestamptz, delivery_photo_key text, technician_signature_key text, employee_signature_key text, technician_signature_confirmed boolean NOT NULL DEFAULT false, employee_signature_confirmed boolean NOT NULL DEFAULT false, notes text, UNIQUE(tenant_id,number));
CREATE TABLE epi_request_items (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), request_id uuid NOT NULL REFERENCES epi_requests(id) ON DELETE CASCADE, item_id uuid NOT NULL REFERENCES items(id), quantity numeric NOT NULL CHECK(quantity > 0), UNIQUE(request_id,item_id));
CREATE TABLE epi_deliveries (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), request_id uuid REFERENCES epi_requests(id), person_id uuid NOT NULL REFERENCES people(id), item_id uuid NOT NULL REFERENCES items(id), quantity numeric NOT NULL CHECK(quantity > 0), delivered_at timestamptz NOT NULL DEFAULT now(), certificate_number text, signature_key text, replacement_due date);
CREATE TABLE vehicles (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), asset_id uuid REFERENCES assets(id), plate text NOT NULL, make text, model text, year int, odometer numeric, UNIQUE(tenant_id,plate));
CREATE TABLE checklists (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), name text NOT NULL, module text NOT NULL, version int NOT NULL DEFAULT 1, definition jsonb NOT NULL, active boolean NOT NULL DEFAULT true);
CREATE TABLE attachments (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), tenant_id uuid NOT NULL REFERENCES tenants(id), entity_type text NOT NULL, entity_id uuid NOT NULL, storage_key text NOT NULL, file_name text NOT NULL, mime_type text NOT NULL, size_bytes bigint NOT NULL, sha256 text NOT NULL, created_at timestamptz NOT NULL DEFAULT now());
CREATE TABLE refresh_tokens (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), user_id uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE, token_hash text UNIQUE NOT NULL, expires_at timestamptz NOT NULL, revoked_at timestamptz, created_at timestamptz NOT NULL DEFAULT now());
CREATE TABLE audit_logs (id bigserial PRIMARY KEY, tenant_id uuid, actor_user_id uuid REFERENCES users(id), action text NOT NULL, entity_type text NOT NULL, entity_id text, ip inet, details jsonb NOT NULL DEFAULT '{}', created_at timestamptz NOT NULL DEFAULT now());

CREATE INDEX idx_ticket_tenant_status ON tickets(tenant_id,status,requested_at DESC);
CREATE INDEX idx_asset_tenant_sector ON assets(tenant_id,sector_id);
CREATE INDEX idx_audit_tenant_time ON audit_logs(tenant_id,created_at DESC);
ALTER TABLE tickets ENABLE ROW LEVEL SECURITY;
ALTER TABLE assets ENABLE ROW LEVEL SECURITY;
ALTER TABLE work_orders ENABLE ROW LEVEL SECURITY;
CREATE POLICY tenant_tickets ON tickets USING (tenant_id = nullif(current_setting('app.tenant_id',true),'')::uuid);
CREATE POLICY tenant_assets ON assets USING (tenant_id = nullif(current_setting('app.tenant_id',true),'')::uuid);
CREATE POLICY tenant_work_orders ON work_orders USING (tenant_id = nullif(current_setting('app.tenant_id',true),'')::uuid);

INSERT INTO tenants(code,name) VALUES ('GRAFMARQUES','Grafmarques'),('INFINNI','INFINNI'),('MPRINT','M.Print');
INSERT INTO sectors(tenant_id,name) SELECT id,'Administracao' FROM tenants;
INSERT INTO people(tenant_id,sector_id,full_name,document,email) SELECT t.id,s.id,'Administrador Geral','00000000000','admin@operix.local' FROM tenants t JOIN sectors s ON s.tenant_id=t.id WHERE t.code='GRAFMARQUES';
INSERT INTO users(person_id,email,password_hash) SELECT id,'admin@operix.local',crypt('TroqueAgora!2026',gen_salt('bf',12)) FROM people WHERE email='admin@operix.local';
INSERT INTO memberships(user_id,tenant_id,role) SELECT u.id,t.id,'SUPER_ADMIN' FROM users u CROSS JOIN tenants t WHERE u.email='admin@operix.local';
INSERT INTO priorities(tenant_id,level,name,response_minutes,resolution_minutes) SELECT id,'LOW'::priority_level,'Baixa',480,4320 FROM tenants UNION ALL SELECT id,'NORMAL'::priority_level,'Normal',240,1440 FROM tenants UNION ALL SELECT id,'HIGH'::priority_level,'Alta',60,480 FROM tenants UNION ALL SELECT id,'CRITICAL'::priority_level,'Critica',15,120 FROM tenants;
